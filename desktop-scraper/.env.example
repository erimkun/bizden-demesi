APP_URL=https://your-app.vercel.app
INGEST_SECRET=same-secret-as-api

# Leave empty to use desktop-scraper/.browser-profile, then log in once there.
# To try your real Chrome profile, set both values below and close Chrome before running.
# CHROME_USER_DATA_DIR=C:\Users\your-user\AppData\Local\Google\Chrome\User Data
# CHROME_PROFILE=Default

# Optional debug output.
DESKTOP_SCRAPER_ARTIFACT_DIR=artifacts
