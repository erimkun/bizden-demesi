PORT=3001
NODE_ENV=development

# SQLite database file path (relative to backend/)
DB_PATH=./data/biletkarsilastir.db

# Scrape interval in hours (default: 4)
SCRAPE_INTERVAL_HOURS=4

# Admin key for triggering manual scrapes via API
ADMIN_KEY=change-me-before-deploy

# Price history retention in days
HISTORY_DAYS=90
