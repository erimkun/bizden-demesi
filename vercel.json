{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install && cd biletkarsilastir && npm install",
  "buildCommand": "cd biletkarsilastir && npm run build",
  "outputDirectory": "biletkarsilastir/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" }
  ]
}
